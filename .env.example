# SENTINEL environment. Every variable the code actually reads is listed here;
# the previous version documented TRAJECTORY_CONFIG and TRAJECTORY_LOG_LEVEL,
# which nothing in the repository referenced.

# --- Demo mode ---------------------------------------------------------------
# On by default so `docker compose up -d` works with no setup. The API accepts
# the published demo key only while this is true. Set to false for anything
# reachable from a public network and supply your own key instead.
SENTINEL_DEMO_MODE=true

# Published demo credential, valid only in demo mode. It is in the README, so it
# is not a secret.
SENTINEL_BOOTSTRAP_KEY=sent_demo_key_2026

# Allow the dashboard's "Initiate Attack" button, which subprocesses
# scripts/full_attack.py. Also requires STREAMLIT_SERVER_ADDRESS to be loopback.
SENTINEL_ALLOW_ATTACK_DEMO=true

# --- Model artifacts ---------------------------------------------------------
# Directory holding the checksummed release bundle. Defaults to
# models/release/v1 when unset.
# SENTINEL_ARTIFACTS_DIR=models/release/v1

# --- Service wiring ----------------------------------------------------------
# SENTINEL_AUTH_DIR=reports/api
# SENTINEL_DB_PATH=reports/api/sentinel.db
# SENTINEL_PORT=8100
# SENTINEL_THRESHOLD=0.45

# --- Optional: ATT&CK Flow bundles for /v1/predict/next ----------------------
# Without this the endpoint reports transition_source() == "literal-prior-table".
# SENTINEL_ATTACK_FLOW_DIR=reports/attack-flow

# --- Optional: threat-intel feed (URLhaus) -----------------------------------
# SENTINEL_THREAT_FEED_FILE=reports/threat_intel/feed.json

# --- Optional: alerting (off unless set) -------------------------------------
# SENTINEL_ALERT_THRESHOLD=0.7
# SENTINEL_WEBHOOK_URL=
# SENTINEL_SLACK_WEBHOOK=
# SENTINEL_SMTP_HOST=
# SENTINEL_SMTP_PORT=587
# SENTINEL_SMTP_USER=
# SENTINEL_SMTP_PASS=
# SENTINEL_ALERT_EMAIL=
# SENTINEL_ALERT_FROM=

# --- Optional: IDURAR lab target (needs ../idurar-erp-crm) -------------------
# See docker-compose.lab.yml.
# IDURAR_JWT_SECRET=
