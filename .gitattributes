# Order matters here: the last matching rule wins, so the specific `-text` rules
# come after the generic text rules. They previously did not, and `*.yaml
# text eol=lf` silently overrode the rule protecting the bundle.
#
# Generic: keep Python and YAML diffs sane everywhere else.
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# The release bundle is verified by SHA-256 in CI, so it has to be byte-identical
# everywhere. With core.autocrlf=true and no rule here, git stored the text files
# as LF while the export had hashed the Windows working-tree copies as CRLF, so 11
# of the 18 files failed their hash on the Linux runner while passing on Windows.
# The release job is the one that must never rot quietly, because the bundle it
# checks is what a reviewer and a deployment both load.
models/release/** -text

# Same reasoning for the generated reports: they are inputs to the claims audit,
# and a rewritten line ending would change bytes a report is compared on.
reports/generated/** -text

# The export copies configs/default.yaml into the bundle verbatim, so this file's
# bytes *are* the bundle's bytes. Without -text it was CRLF in one checkout and LF
# in another, which is how the bundle ended up verifiable on one machine only.
configs/** -text
