.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]
*.egg-info/

# Local configuration and credentials
.env
.env.*
!.env.example

# Datasets and generated artifacts
data/raw/
data/interim/
data/processed/
models/checkpoints/
reports/generated/
*.pcap
*.pcapng
*.csv
!data/fixtures/*.csv
*.parquet
# Exception: the committed pre-windowed CIC-IDS2017 aggregate, so a clone can
# render measured numbers without the 1.2 GB download. Aggregates only - no raw
# flows - and carries the required citation in data/derived/PROVENANCE.md.
!data/derived/*.parquet
*.pt
*.pth
*.onnx

# Exception: committed release bundle (checksummed, versioned)
!models/release/**/*.pt
!models/release/**/*.joblib
!models/release/**/*.json
!models/release/**/*.yaml

# Local editor and OS files
.idea/
.vscode/
.DS_Store

# Live demo runtime data (events, recordings)
reports/live/
reports/api/

# Fetched threat-intel feeds refresh out-of-band; never commit
reports/threat_intel/

# Local trust-ledger records may contain operational alert metadata
reports/generated/ledger/

# Video production captures, renders, and generated workspaces (hundreds of MB)
video/
brag-output*/

# Knowledge-graph / skill installers (local tooling, regenerable)
graphify-out/
.agents/
skills-lock.json

# Local audit notes from the code-review plugin (not product documentation)
DUAL_DASHBOARD_PORTS.md
PLUGIN_MEMORY.md
PORT_AUDIT.md
UI_INTERACTION_AUDIT.md

# Local research clones; never ship third-party repositories
research/repos/

# agent/editor tool state
.codewhale/
