[Unit]
Description=SENTINEL Flow Sensor — captures network events and pushes to API
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/home/sentinel/sentinel
EnvironmentFile=/home/sentinel/sentinel/.env
ExecStart=/home/sentinel/sentinel/.venv/bin/python scripts/flow_sensor.py --interface eth0 --api http://127.0.0.1:8100
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-flow-sensor
# Security hardening
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/sentinel/sentinel /var/log/sentinel
PrivateTmp=true

[Install]
WantedBy=multi-user.target
